{
  "name": "ibra-fawateh",
  "productName": "فواتح ومناسبات IBRA",
  "version": "1.2.0",
  "description": "فواتح ومناسبات IBRA — دليل الفواتح والمناسبات ودفتر الفضل",
  "author": "Ibrahim Alkhazraji (IBRAPROGRAM)",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "android": "npx cap add android && node scripts/native-assets.js android && npx cap sync android",
    "ios": "npx cap add ios && node scripts/native-assets.js ios && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ibraprogram.fawateh",
    "productName": "فواتح ومناسبات IBRA",
    "artifactName": "IBRA-Fawateh-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "IBRA-Fawateh-${version}-Setup.${ext}",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "فواتح ومناسبات IBRA",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "language": "1025"
    },
    "portable": {
      "artifactName": "IBRA-Fawateh-${version}-portable.${ext}"
    }
  }
}